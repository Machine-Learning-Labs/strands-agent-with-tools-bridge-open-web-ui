# AWS Credentials for Bedrock (Required - choose one option)

# Option 1: Bedrock API Key (recommended for development)
# Get from: https://console.aws.amazon.com/bedrock → API keys
AWS_BEDROCK_API_KEY=your_bedrock_api_key_here

# Option 2: AWS Credentials (recommended for production)
# AWS_ACCESS_KEY_ID=your_aws_access_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
# AWS_DEFAULT_REGION=us-west-2

# API Keys for external services

# Tavily API Key (Optional - for Tavily Search Agent)
# Get from: https://tavily.com/ (free tier available)
# Without this key, the Tavily Search Agent will not be available
TAVILY_API_KEY=tvly-***-********************************

# Other optional API keys (for future agents)
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# STABILITY_API_KEY=your_stability_api_key
# SLACK_BOT_TOKEN=your_slack_bot_token

# OpenAI API Key (for Open Web UI compatibility)
# This can be any string - it's used for authentication between services
OPENAI_API_KEY=sk-strands-agent-demo-key

# PostgreSQL Configuration
POSTGRES_DB=openwebui
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Open Web UI Configuration
WEBUI_SECRET_KEY=change-me-in-production-to-a-random-string

# Logging
LOG_LEVEL=INFO
